        <mxCell id="lbl-no2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="No" vertex="1">
          <mxGeometry height="30" width="40" x="195" y="896" as="geometry" />
