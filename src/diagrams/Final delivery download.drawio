        <!-- af1a → af1b -->
        <mxCell id="e6" edge="1" source="af1a" target="af1b" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- af1b → end2 -->
        <mxCell id="e7" edge="1" source="af1b" target="end2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" value="">
          <mxGeometry relative="1" as="geometry" />
