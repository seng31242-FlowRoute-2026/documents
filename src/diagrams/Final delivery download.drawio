<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="UC05-FinalDeliveryDownload-v2">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- START STATE -->
        <mxCell id="start" parent="1" style="ellipse;html=1;shape=startState;" value="" vertex="1">
          <mxGeometry height="70" width="70" x="195" y="30" as="geometry" />
        </mxCell>

        <!-- Step 1: System notifies client -->
        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="System notifies client: video ready for download" vertex="1">
          <mxGeometry height="60" width="140" x="160" y="140" as="geometry" />
        </mxCell>

        <!-- Step 2: Client logs in and navigates -->
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Client logs in and navigates to delivery dashboard" vertex="1">
          <mxGeometry height="60" width="140" x="160" y="240" as="geometry" />
        </mxCell>

        <!-- Step 3: Client clicks download on completed video asset -->
        <mxCell id="s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Client clicks download on completed video asset" vertex="1">
          <mxGeometry height="60" width="140" x="160" y="340" as="geometry" />
        </mxCell>

        <!-- Decision: Auth and ownership verified? -->
        <mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;" value="Auth &amp; ownership verified?" vertex="1">
          <mxGeometry height="110" width="130" x="165" y="440" as="geometry" />
        </mxCell>

        <!-- Alt Flow 1a: System denies access, shows auth error -->
        <mxCell id="af1a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="System denies access, shows authorization error" vertex="1">
          <mxGeometry height="60" width="140" x="380" y="440" as="geometry" />
        </mxCell>

        <!-- Alt Flow 1b: Client prompted to re-login or contact support -->
        <mxCell id="af1b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Client prompted to re-login or contact support" vertex="1">
          <mxGeometry height="60" width="140" x="380" y="540" as="geometry" />
        </mxCell>

        <!-- Alt Flow 1 END STATE -->
        <mxCell id="end2" parent="1" style="ellipse;html=1;shape=endState;" value="" vertex="1">
          <mxGeometry height="50" width="50" x="425" y="635" as="geometry" />
        </mxCell>

        <!-- Step 5: System generates secure time-limited download link -->
        <mxCell id="s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="System generates secure, time-limited download link" vertex="1">
          <mxGeometry height="60" width="140" x="160" y="590" as="geometry" />
        </mxCell>

        <!-- Step 6: Client clicks download link, file transfer begins -->
        <mxCell id="s6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Client clicks download link, file transfer begins" vertex="1">
          <mxGeometry height="60" width="140" x="160" y="690" as="geometry" />
        </mxCell>

        <!-- Decision: Download link expired? -->
        <mxCell id="d2" parent="1" style="rhombus;whiteSpace=wrap;html=1;" value="Download link expired?" vertex="1">
          <mxGeometry height="100" width="130" x="165" y="790" as="geometry" />
        </mxCell>

        <!-- Alt Flow 2a: System shows link expiry message -->
        <mxCell id="af2a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="System shows link expiry message" vertex="1">
          <mxGeometry height="60" width="130" x="20" y="800" as="geometry" />
        </mxCell>

        <!-- Alt Flow 2b: Client requests new download link (loops to s5) -->
        <mxCell id="af2b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Client requests new download link" vertex="1">
          <mxGeometry height="60" width="130" x="20" y="890" as="geometry" />
        </mxCell>

        <!-- Decision: Transfer successful? -->
        <mxCell id="d3" parent="1" style="rhombus;whiteSpace=wrap;html=1;" value="Transfer successful?" vertex="1">
          <mxGeometry height="100" width="130" x="165" y="930" as="geometry" />
        </mxCell>

        <!-- Alt Flow 3: System retains link for remainder of valid period -->
        <mxCell id="af3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="System retains link for remainder of valid period" vertex="1">
          <mxGeometry height="60" width="140" x="380" y="950" as="geometry" />
        </mxCell>

        <!-- Step 7: System logs download event -->
        <mxCell id="s7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="System logs download event: Client ID, Video ID, timestamp" vertex="1">
          <mxGeometry height="60" width="140" x="160" y="1070" as="geometry" />
        </mxCell>

        <!-- Step 8: System marks video asset lifecycle as closed -->
        <mxCell id="s8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="System marks video asset lifecycle as closed" vertex="1">
          <mxGeometry height="60" width="140" x="160" y="1170" as="geometry" />
        </mxCell>

        <!-- MAIN END STATE -->
        <mxCell id="end1" parent="1" style="ellipse;html=1;shape=endState;" value="" vertex="1">
