        </mxCell>

        <!-- Step 5: Pod sends Review update -->
        <mxCell id="s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Pod finishes processing, sends status update → &quot;Review&quot;" vertex="1">
