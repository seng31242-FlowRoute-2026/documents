  <diagram name="Page-1" id="UC04-UpdateVideoStatus-v2">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- START STATE -->
        <mxCell id="start" parent="1" style="ellipse;html=1;shape=startState;" value="" vertex="1">
          <mxGeometry height="70" width="70" x="45" y="40" as="geometry" />
        </mxCell>

        <!-- Step 1: Pod completes processing stage -->
        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Pod completes current processing stage on assigned video task" vertex="1">
          <mxGeometry height="60" width="120" x="20" y="150" as="geometry" />
        </mxCell>

        <!-- Step 2: Pod sends In Progress update -->
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Pod sends status update request → &quot;In Progress&quot;" vertex="1">
