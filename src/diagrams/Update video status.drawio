        </mxCell>

        <!-- Alt Flow 2a: Pod retries -->
        <mxCell id="af2a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Pod retries request up to 3 times (5-second interval)" vertex="1">
