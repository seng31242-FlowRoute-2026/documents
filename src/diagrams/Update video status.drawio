        </mxCell>

        <!-- Decision: System validates pod identity and task -->
        <mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;" value="System validates pod identity &amp; task assignment?" vertex="1">
          <mxGeometry height="140" width="140" x="210" y="210" as="geometry" />
        </mxCell>

        <!-- Alt Flow 1a: Reject request - auth error -->
        <mxCell id="af1a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="System rejects request, returns authentication error" vertex="1">
          <mxGeometry height="60" width="120" x="220" y="80" as="geometry" />
        </mxCell>

        <!-- Alt Flow 1b: Pod notified, no status change -->
        <mxCell id="af1b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Pod notified, no status change recorded" vertex="1">
          <mxGeometry height="60" width="120" x="400" y="80" as="geometry" />
